{
  "compilerOptions": {
    "target": "es2025",
    "module": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true
  },
  "include": ["src"]
}